# =========================================================
# Temel: Hareketli / Yeniden Boyutlandırılabilir Panel
# =========================================================
class MovablePanel(ttk.Frame):
    """
    Sağ taraftaki çalışma alanında yer alan tüm paneller için temel sınıf:
    - Başlık çubuğundan sürükleyerek taşıma
    - Sağ alttaki sizegrip ile yeniden boyutlandırma
    - X butonu ile panel kapama
    """
    def __init__(self, master_canvas, app, title="Panel"):
        super().__init__(master_canvas)
        self.app = app
        self.master_canvas = master_canvas

        # --- Başlık çubuğu ---
        header = ttk.Frame(self, relief="raised")
        header.pack(side="top", fill="x")

        self.title_label = ttk.Label(header, text=title, anchor="w")
        self.title_label.pack(side="left", padx=4)

        close_btn = ttk.Button(header, text="X", width=2, command=self._on_close)
        close_btn.pack(side="right", padx=2)

        for w in (header, self.title_label):
            w.bind("<Button-1>", self._on_header_press)
            w.bind("<B1-Motion>", self._on_header_drag)
            w.bind("<ButtonRelease-1>", self._on_header_release)

        # --- Alt kısım / resize grip ---
        bottom_bar = ttk.Frame(self)
        bottom_bar.pack(side="bottom", fill="x")
        self.size_grip = ttk.Sizegrip(bottom_bar)
        self.size_grip.pack(side="right")

        for w in (self.size_grip,):
            w.bind("<Button-1>", self._on_resize_press)
            w.bind("<B1-Motion>", self._on_resize_drag)
            w.bind("<ButtonRelease-1>", self._on_resize_release)

    # --- header drag delegasyonları ---
    def _on_header_press(self, event):
        self.app.set_active_panel(self)
        self.app.start_move_panel(self, event)

    def _on_header_drag(self, event):
        self.app.drag_move_panel(self, event)

    def _on_header_release(self, event):
        self.app.end_move_panel(self, event)

    # --- resize delegasyonları ---
    def _on_resize_press(self, event):
        self.app.set_active_panel(self)
        self.app.start_resize_panel(self, event)

    def _on_resize_drag(self, event):
        self.app.drag_resize_panel(self, event)

    def _on_resize_release(self, event):
        self.app.end_resize_panel(self, event)

    # --- kapama ---
    def _on_close(self):
        self.app.close_panel(self)


# =========================================================
# Karşılaştırma Paneli
# =========================================================
class ComparePanel(MovablePanel):
    """
    Farklı DXD'lerden seçilen turuncu segmentleri tek grafikte kıyaslar.
    """
    def __init__(self, master_canvas, app):
        super().__init__(master_canvas, app, title="Karşılaştırma")
        self.segments = []  # {file, channel, seg_index, t_rel, y}

        main = ttk.Frame(self)
        main.pack(fill="both", expand=True, padx=5, pady=5)

        plot_frame = ttk.LabelFrame(main, text="Seçilen Bölgeler")
        plot_frame.pack(fill="both", expand=True)

        self.fig = Figure(figsize=(6, 4), dpi=100)
        self.ax = self.fig.add_subplot(111)
        self.ax.grid(True)

        toolbar_frame = ttk.Frame(plot_frame)
        toolbar_frame.pack(side="top", fill="x")

        self.canvas = FigureCanvasTkAgg(self.fig, master=plot_frame)
        self.canvas_widget = self.canvas.get_tk_widget()
        self.canvas_widget.pack(side="top", fill="both", expand=True)

        self.toolbar = NavigationToolbar2Tk(self.canvas, toolbar_frame)
        self.toolbar.update()

        bottom = ttk.Frame(main)
        bottom.pack(fill="x", pady=5)

        ttk.Button(bottom, text="Temizle", command=self.clear_segments).pack(side="right", padx=5)
        ttk.Button(bottom, text="Export CSV", command=self.export_csv).pack(side="right", padx=5)

        self.status_label = ttk.Label(bottom, text="Segment yok", anchor="w")
        self.status_label.pack(side="left", padx=5, fill="x", expand=True)

    def add_segment(self, t_full, y_full, t0, t1, chan_name, source_file):
        mask = (t_full >= t0) & (t_full <= t1)
        if mask.sum() < 2:
            return

        t_seg = t_full[mask]
        y_seg = y_full[mask]
        t_rel = t_seg - t_seg[0]

        seg_index = len(self.segments) + 1
        seg = {
            "file": source_file,
            "channel": chan_name,
            "seg_index": seg_index,
            "t_rel": t_rel,
            "y": y_seg,
        }
        self.segments.append(seg)
        self._redraw()

    def _redraw(self):
        self.ax.clear()
        self.ax.grid(True)

        if not self.segments:
            self.ax.set_title("Henüz segment seçilmedi")
            self.canvas.draw()
            self.status_label.config(text="Segment yok")
            return

        colors = [f"C{i}" for i in range(10)]

        for i, seg in enumerate(self.segments):
            c = colors[i % len(colors)]
            t_rel = seg["t_rel"]
            y = seg["y"]
            label = f"{os.path.basename(seg['file'])} | {seg['channel']} | #{seg['seg_index']}"
            self.ax.plot(t_rel, y, label=label, color=c)

        self.ax.set_xlabel("Zaman (s) (segmente göre)")
        self.ax.set_ylabel("Değer")
        self.ax.set_title("Seçilen turuncu bölgelerin karşılaştırması")
        self.ax.legend()
        self.canvas.draw()
        self.toolbar.update()
        self.status_label.config(text=f"{len(self.segments)} segment")

    def clear_segments(self):
        self.segments.clear()
        self._redraw()

    def export_csv(self):
        if not self.segments:
            messagebox.showwarning("Export", "Export edilecek segment yok.")
            return

        desktop = os.path.join(os.path.expanduser("~"), "Desktop")
        os.makedirs(desktop, exist_ok=True)
        out_path = os.path.join(desktop, "DNASoftX_CompareExport.csv")

        try:
            with open(out_path, "w", newline="", encoding="utf-8") as f:
                wr = csv.writer(f, delimiter=";")
                wr.writerow(["file", "channel", "segment_index",
                             "sample_index", "t_rel_s", "value"])

                for seg in self.segments:
                    file = seg["file"]
                    channel = seg["channel"]
                    seg_index = seg["seg_index"]
                    t_rel = seg["t_rel"]
                    y = seg["y"]
                    for i in range(len(t_rel)):
                        wr.writerow([
                            file,
                            channel,
                            seg_index,
                            i,
                            float(t_rel[i]),
                            float(y[i]),
                        ])

            messagebox.showinfo("Export", f"CSV oluşturuldu:\n{out_path}")
        except Exception as e:
            messagebox.showerror("Export hatası", str(e))


# =========================================================
# DXD Viewer Paneli
# =========================================================
class ViewerPanel(MovablePanel):
    """
    Her DXD dosyası için:
      - Tek bir grafik (matplotlib)
      - Trigger ile turuncu bölgeleri işaretleme
      - Segmentleri ComparePanel'e gönderme
    Kontroller sol alttaki global panelden yapılır.
    """
    def __init__(self, master_canvas, app, filepath):
        title = os.path.basename(filepath)
        super().__init__(master_canvas, app, title=title)
        self.filepath = filepath
        self.dwfile = None

        self.last_t = None
        self.last_y = None
        self.last_chan = None
        self.intervals = []  # [(t0, t1)]

        self._drag_interval_index = None

        self._build_ui()
        self._load_file()
        self.show_blank()

    def _build_ui(self):
        content = ttk.Frame(self)
        content.pack(fill="both", expand=True)

        plot = ttk.LabelFrame(content, text="Grafik")
        plot.pack(fill="both", expand=True, padx=5, pady=5)

        self.fig = Figure(figsize=(6, 4), dpi=100)
        self.ax = self.fig.add_subplot(111)
        self.ax.grid(True)

        toolbar_frame = ttk.Frame(plot)
        toolbar_frame.pack(side="top", fill="x")

        self.canvas = FigureCanvasTkAgg(self.fig, master=plot)
        self.canvas_widget = self.canvas.get_tk_widget()
        self.canvas_widget.pack(side="top", fill="both", expand=True)

        self.toolbar = NavigationToolbar2Tk(self.canvas, toolbar_frame)
        self.toolbar.update()

        # Matplotlib eventler
        self.canvas.mpl_connect("button_press_event", self.on_press)
        self.canvas.mpl_connect("button_release_event", self.on_release)

    def _load_file(self):
        if dw is None:
            return
        try:
            self.dwfile = dw.DWFile(self.filepath)
        except Exception as e:
            messagebox.showerror("Hata", f"DXD okunamadı:\n{e}")
            self.dwfile = None

    def get_channels(self):
        if self.dwfile is None:
            return []
        try:
            return sorted(list(self.dwfile.keys()))
        except Exception:
            return []

    def show_blank(self):
        self.ax.clear()
        self.ax.grid(True)
        self.ax.set_title(os.path.basename(self.filepath))
        self.canvas.draw()
        self.toolbar.update()

    def plot_channel(self, chan, rising=None, falling=None, pad=0.0, apply_trigger=True):
        if self.dwfile is None or not chan:
            return

        try:
            s = self.dwfile[chan].series()
        except Exception as e:
            messagebox.showerror("Hata", f"Kanal okunamadı:\n{e}")
            return

        if s is None or s.empty:
            self.ax.clear()
            self.ax.set_title("Veri boş")
            self.canvas.draw()
            return

        t = s.index.to_numpy()
        y = s.to_numpy(dtype=float)

        self.last_t = t
        self.last_y = y
        self.last_chan = chan
        self.intervals = []

        self.ax.clear()
        self.ax.grid(True)
        self.ax.plot(t, y, label=chan)

        if apply_trigger and rising is not None:
            self.intervals = self._compute_intervals(t, y, rising, falling, pad)
            for (t0, t1) in self.intervals:
                start = max(t0 - pad, t[0])
                end = min(t1 + pad, t[-1])
                self.ax.axvspan(start, end, color="orange", alpha=0.3)
                self.ax.axvline(t0, color="green", linestyle="--", alpha=0.8)
                self.ax.axvline(t1, color="red", linestyle="--", alpha=0.8)

        self.ax.set_title(chan)
        self.ax.legend()
        self.canvas.draw()
        self.toolbar.update()

    @staticmethod
    def _compute_intervals(t, y, rising, falling, pad):
        intervals = []
        r = float(rising)
        f = float(falling) if falling is not None else r

        if f < r:
            f = r

        if abs(f - r) < 1e-9:
            # Tek eşik
            thr = r
            state = "below"
            t_start = None

            for i in range(len(y) - 1):
                y0, y1 = y[i], y[i + 1]
                t1 = t[i + 1]

                if state == "below":
                    if (y0 < thr) and (y1 >= thr):
                        t_start = t1
                        state = "above"

                elif state == "above":
                    if (y0 > thr) and (y1 <= thr):
                        t_end = t1
                        intervals.append((t_start, t_end))
                        state = "below"
                        t_start = None
        else:
            # Çift eşik: rising < falling
            low = r
            high = f

            state = "waiting_rise"
            t_start = None
            seen_high = False

            for i in range(len(y) - 1):
                y0, y1 = y[i], y[i + 1]
                t0, t1 = t[i], t[i + 1]

                if state == "waiting_rise":
                    if (y0 < low) and (y1 >= low):
                        t_start = t1
                        state = "above_low"
                        seen_high = False

                elif state == "above_low":
                    if (y0 >= low) and (y1 < low):
                        state = "waiting_rise"
                        t_start = None
                        seen_high = False
                        continue

                    if (not seen_high) and (y0 < high) and (y1 >= high):
                        seen_high = True

                    if seen_high and (y0 > high) and (y1 <= high):
                        t_end = t1
                        intervals.append((t_start, t_end))
                        state = "waiting_rise"
                        t_start = None
                        seen_high = False

        return intervals

    # --- turuncu alan seçimi (segment ComparePanel'e) ---
    def on_press(self, event):
        self.app.set_active_panel(self)
        if event.inaxes != self.ax or event.xdata is None:
            self._drag_interval_index = None
            return

        x = event.xdata
        idx = None
        for i, (t0, t1) in enumerate(self.intervals):
            if t0 <= x <= t1:
                idx = i
                break

        self._drag_interval_index = idx

    def on_release(self, event):
        if self._drag_interval_index is None:
            return

        compare_panel = self.app.ensure_compare_panel()
        if compare_panel is None:
            self._drag_interval_index = None
            return

        if self.last_t is None or self.last_y is None or self.last_chan is None:
            self._drag_interval_index = None
            return

        t0, t1 = self.intervals[self._drag_interval_index]
        compare_panel.add_segment(self.last_t, self.last_y, t0, t1,
                                  self.last_chan, self.filepath)

        self._drag_interval_index = None


# =========================================================
# Ana Uygulama
# =========================================================
class DxdViewerApp(tk.Tk):
    """
    DNASoft X - Measurement UI tarzı Python arayüzü
    - Sol: iç dosya gezgini + kontrol paneli
    - Sağ: çoklu grafik panelleri (organize edilebilir)
    """
    def __init__(self):
        super().__init__()
        self.title("DNASoft X - DXD Viewer (Python)")
        self.geometry("1400x800")
        self.last_folder = os.getcwd()

        if dw is None:
            messagebox.showerror(
                "dwdatareader yok",
                "dwdatareader modülü bulunamadı.\n\npip install dwdatareader"
            )

        self.panels = []        # {panel, win_id, x, y, w, h}
        self.compare_panel = None
        self.active_panel = None
        self._drag_state = None
        self.auto_layout = True
        self.panel_offset = 0

        self._build_shell()

    # --- Shell Layout ---
    def _build_shell(self):
        top_bar = ttk.Frame(self)
        top_bar.pack(side="top", fill="x")

        ttk.Label(
            top_bar,
            text="DNASoft X - DXD Viewer",
            anchor="w",
            font=("Segoe UI", 11, "bold"),
        ).pack(side="left", padx=10, pady=5, fill="x", expand=True)

        main_pane = ttk.PanedWindow(self, orient="horizontal")
        main_pane.pack(fill="both", expand=True)

        left_frame = ttk.Frame(main_pane, width=350)
        main_pane.add(left_frame, weight=0)

        right_frame = ttk.Frame(main_pane)
        main_pane.add(right_frame, weight=1)

        self._build_left_side(left_frame)
        self._build_workspace(right_frame)

    def _build_left_side(self, parent):
        vpaned = ttk.PanedWindow(parent, orient="vertical")
        vpaned.pack(fill="both", expand=True)

        explorer_frame = ttk.Frame(vpaned)
        control_frame = ttk.Frame(vpaned, relief="groove", borderwidth=1)

        vpaned.add(explorer_frame, weight=3)
        vpaned.add(control_frame, weight=2)

        self._build_file_explorer(explorer_frame)
        self._build_control_panel(control_frame)

    # --- Sağ taraf / Workspace ---
    def _build_workspace(self, parent):
        toolbar = ttk.Frame(parent)
        toolbar.pack(side="top", fill="x")

        ttk.Button(toolbar, text="Organize et", command=self.organize_panels)\
            .pack(side="left", padx=5, pady=3)

        ttk.Button(toolbar, text="Export CSV", command=self.global_export_csv)\
            .pack(side="left", padx=5, pady=3)

        self.workspace_canvas = tk.Canvas(parent, background="#202020")
        self.workspace_canvas.pack(side="top", fill="both", expand=True)

    def _create_panel_window(self, panel, width=700, height=400):
        # Cascade default (auto_layout kapalıyken veya ComparePanel için)
        x = 20 + (self.panel_offset * 30)
        y = 20 + (self.panel_offset * 30)
        self.panel_offset += 1

        win_id = self.workspace_canvas.create_window(
            x, y, window=panel, anchor="nw", width=width, height=height
        )

        self.panels.append(
            {"panel": panel, "win_id": win_id, "x": x, "y": y, "w": width, "h": height}
        )

    def open_dxd_panel(self, filepath):
        panel = ViewerPanel(self.workspace_canvas, self, filepath)
        self._create_panel_window(panel)
        if self.auto_layout:
            self.organize_panels()
        self.set_active_panel(panel)

    # --- Sol: Dosya Gezgini ---
    def _build_file_explorer(self, parent):
        ttk.Label(parent, text="Dosya Gezgini (DXD/D7D)", font=("Segoe UI", 10, "bold"))\
            .pack(anchor="w", padx=5, pady=5)

        path_frame = ttk.Frame(parent)
        path_frame.pack(fill="x", padx=5, pady=2)

        self.path_var = tk.StringVar(value=self.last_folder)

        ttk.Label(path_frame, text="Klasör:").pack(side="left")
        path_entry = ttk.Entry(path_frame, textvariable=self.path_var)
        path_entry.pack(side="left", fill="x", expand=True, padx=5)

        ttk.Button(path_frame, text="Git", command=self.refresh_file_list)\
            .pack(side="right")
        path_entry.bind("<Return>", lambda e: self.refresh_file_list())

        explorer_pane = ttk.PanedWindow(parent, orient="vertical")
        explorer_pane.pack(fill="both", expand=True, padx=5, pady=5)

        drv_frame = ttk.Frame(explorer_pane, height=120)
        explorer_pane.add(drv_frame, weight=0)

        ttk.Label(drv_frame, text="Sürücüler / Kısayollar").pack(anchor="w")

        self.drv_list = tk.Listbox(drv_frame, height=6)
        self.drv_list.pack(side="left", fill="both", expand=True)

        drv_scroll = ttk.Scrollbar(drv_frame, orient="vertical", command=self.drv_list.yview)
        drv_scroll.pack(side="right", fill="y")
        self.drv_list.config(yscrollcommand=drv_scroll.set)

        self.drv_list.bind("<Double-1>", self.on_drive_activate)
        self.drv_list.bind("<Return>", self.on_drive_activate)

        file_frame = ttk.Frame(explorer_pane)
        explorer_pane.add(file_frame, weight=1)

        self.file_list = tk.Listbox(file_frame)
        self.file_list.pack(side="left", fill="both", expand=True)

        file_scroll = ttk.Scrollbar(file_frame, orient="vertical",
                                    command=self.file_list.yview)
        file_scroll.pack(side="right", fill="y")
        self.file_list.config(yscrollcommand=file_scroll.set)

        self.file_list.bind("<Double-1>", self.open_selected_file)
        self.file_list.bind("<Return>", self.open_selected_file)

        self.file_entries = []

        self.refresh_drives()
        self.refresh_file_list()

    def _list_drives(self):
        drives = []
        for letter in string.ascii_uppercase:
            drive = f"{letter}:\\"
            if os.path.exists(drive):
                drives.append(drive)
        return drives

    def refresh_drives(self):
        self.drv_list.delete(0, tk.END)
        user_home = os.path.expanduser("~")
        desktop = os.path.join(user_home, "Desktop")
        projects = r"\\albil\tumosan\Tumosan_Ortak\Arge\Test_ve_Validasyon\11_Projeler"

        self.drv_list.insert(tk.END, f"[K] Kullanıcı ({user_home})")
        if os.path.isdir(desktop):
            self.drv_list.insert(tk.END, f"[K] Desktop ({desktop})")
        if os.path.isdir(projects):
            self.drv_list.insert(tk.END, f"[K] 11_Projeler ({projects})")

        for d in self._list_drives():
            self.drv_list.insert(tk.END, f"[S] {d}")

    def on_drive_activate(self, event=None):
        sel = self.drv_list.curselection()
        if not sel:
            return
        text = self.drv_list.get(sel[0])

        if text.startswith("[K]"):
            if "(" in text and text.endswith(")"):
                base = text[text.index("(") + 1:-1]
            else:
                return
            target = base
        elif text.startswith("[S]"):
            parts = text.split()
            target = parts[1]
        else:
            return

        if os.path.isdir(target):
            self.path_var.set(target)
            self.refresh_file_list()

    def refresh_file_list(self):
        folder = os.path.abspath(self.path_var.get())
        if not os.path.isdir(folder):
            messagebox.showwarning("Klasör yok", folder)
            return

        self.path_var.set(folder)
        self.last_folder = folder

        self.file_list.delete(0, tk.END)
        self.file_entries = []

        parent = os.path.dirname(folder)
        if parent and parent != folder:
            self.file_entries.append(("..", "up"))
            self.file_list.insert(tk.END, "[..] Üst Klasör")

        try:
            all_items = os.listdir(folder)
        except PermissionError:
            messagebox.showwarning("Erişim yok", folder)
            return

        dirs = []
        files = []

        for name in all_items:
            full = os.path.join(folder, name)
            if os.path.isdir(full):
                dirs.append(name)
            elif name.lower().endswith(".dxd") or name.lower().endswith(".d7d"):
                files.append(name)

        dirs.sort()
        files.sort()

        for d in dirs:
            self.file_entries.append((d, "dir"))
            self.file_list.insert(tk.END, f"[D] {d}")
        for f in files:
            self.file_entries.append((f, "file"))
            self.file_list.insert(tk.END, f"[F] {f}")

    def open_selected_file(self, event=None):
        sel = self.file_list.curselection()
        if not sel:
            return
        idx = sel[0]
        name, kind = self.file_entries[idx]
        curdir = os.path.abspath(self.path_var.get())
        if kind == "file":
            self.open_dxd_panel(os.path.join(curdir, name))
        elif kind in ("dir", "up"):
            if kind == "up":
                newdir = os.path.dirname(curdir)
            else:
                newdir = os.path.join(curdir, name)
            self.path_var.set(newdir)
            self.refresh_file_list()

    # --- Sol alt: Kontrol paneli ---
    def _build_control_panel(self, parent):
        lf = ttk.LabelFrame(parent, text="DXD Kontrolleri")
        lf.pack(fill="both", expand=True, padx=5, pady=5)

        row0 = ttk.Frame(lf)
        row0.pack(fill="x", pady=2)
        ttk.Label(row0, text="Aktif Dosya:").pack(side="left")
        self.ctrl_file_label = ttk.Label(row0, text="(yok)", foreground="#808080")
        self.ctrl_file_label.pack(side="left", padx=5)

        row1 = ttk.Frame(lf)
        row1.pack(fill="x", pady=2)
        ttk.Label(row1, text="Kanal:").pack(side="left")
        self.ctrl_channel_var = tk.StringVar()
        self.ctrl_channel_combo = ttk.Combobox(
            row1, textvariable=self.ctrl_channel_var, state="disabled", width=30
        )
        self.ctrl_channel_combo.pack(side="left", padx=5, fill="x", expand=True)
        self.ctrl_channel_combo.bind("<<ComboboxSelected>>", self.on_channel_changed)

        trig = ttk.LabelFrame(lf, text="Trigger")
        trig.pack(fill="x", pady=5)

        self.ctrl_rising_var = tk.DoubleVar(value=10.0)
        self.ctrl_falling_var = tk.DoubleVar(value=18.0)
        self.ctrl_pad_var = tk.DoubleVar(value=1.0)

        ttk.Label(trig, text="Rising >").grid(row=0, column=0, sticky="w")
        self.ctrl_rising_entry = ttk.Entry(trig, textvariable=self.ctrl_rising_var,
                                           width=7, state="disabled")
        self.ctrl_rising_entry.grid(row=0, column=1, padx=2)

        ttk.Label(trig, text="Falling <").grid(row=1, column=0, sticky="w")
        self.ctrl_falling_entry = ttk.Entry(trig, textvariable=self.ctrl_falling_var,
                                            width=7, state="disabled")
        self.ctrl_falling_entry.grid(row=1, column=1, padx=2)

        ttk.Label(trig, text="Pad (s)").grid(row=2, column=0, sticky="w")
        self.ctrl_pad_entry = ttk.Entry(trig, textvariable=self.ctrl_pad_var,
                                        width=7, state="disabled")
        self.ctrl_pad_entry.grid(row=2, column=1, padx=2)

        row_btn = ttk.Frame(lf)
        row_btn.pack(fill="x", pady=5)

        self.ctrl_apply_btn = ttk.Button(
            row_btn, text="Uygula", command=self.on_apply_trigger, state="disabled"
        )
        self.ctrl_apply_btn.pack(side="left", padx=2)

        self.ctrl_compare_btn = ttk.Button(
            row_btn, text="Karşılaştırma Paneli",
            command=self.ensure_compare_panel, state="disabled"
        )
        self.ctrl_compare_btn.pack(side="left", padx=2)

    def set_control_enabled(self, enabled):
        state = "normal" if enabled else "disabled"
        self.ctrl_channel_combo.configure(state=("readonly" if enabled else "disabled"))
        self.ctrl_rising_entry.configure(state=state)
        self.ctrl_falling_entry.configure(state=state)
        self.ctrl_pad_entry.configure(state=state)
        self.ctrl_apply_btn.configure(state=state)
        self.ctrl_compare_btn.configure(state=state)

    def set_active_panel(self, panel):
        if isinstance(panel, ViewerPanel):
            self.active_panel = panel
            self.ctrl_file_label.configure(
                text=os.path.basename(panel.filepath),
                foreground="black"
            )
            channels = panel.get_channels()
            self.ctrl_channel_combo["values"] = channels
            self.ctrl_channel_var.set("")
            self.set_control_enabled(bool(channels))
        else:
            self.active_panel = None
            self.ctrl_file_label.configure(text="(yok)", foreground="#808080")
            self.ctrl_channel_combo["values"] = []
            self.ctrl_channel_var.set("")
            self.set_control_enabled(False)

    def on_channel_changed(self, event=None):
        if self.active_panel is None:
            return
        chan = self.ctrl_channel_var.get()
        if not chan:
            return
        try:
            r = float(self.ctrl_rising_var.get())
            f = float(self.ctrl_falling_var.get())
            p = float(self.ctrl_pad_var.get())
        except ValueError:
            messagebox.showwarning("Trigger", "Trigger değerleri sayısal olmalı.")
            return

        # Kanal seçilince şimdilik raw veri çiz (trigger yok)
        self.active_panel.plot_channel(chan, r, f, p, apply_trigger=False)

    def on_apply_trigger(self):
        if self.active_panel is None:
            return
        chan = self.ctrl_channel_var.get()
        if not chan:
            messagebox.showwarning("Kanal", "Önce bir kanal seçin.")
            return
        try:
            r = float(self.ctrl_rising_var.get())
            f = float(self.ctrl_falling_var.get())
            p = float(self.ctrl_pad_var.get())
        except ValueError:
            messagebox.showwarning("Trigger", "Trigger değerleri sayısal olmalı.")
            return

        self.active_panel.plot_channel(chan, r, f, p, apply_trigger=True)

    # --- Compare Panel ---
    def ensure_compare_panel(self):
        if self.compare_panel is None or not self._panel_exists(self.compare_panel):
            self.compare_panel = ComparePanel(self.workspace_canvas, self)
            self._create_panel_window(self.compare_panel, width=800, height=350)
        entry = self._find_panel_entry(self.compare_panel)
        if entry:
            self.workspace_canvas.tag_raise(entry["win_id"])
        return self.compare_panel

    def global_export_csv(self):
        if self.compare_panel and self._panel_exists(self.compare_panel):
            self.compare_panel.export_csv()
        else:
            messagebox.showwarning(
                "Export",
                "Önce karşılaştırma panelini açıp segment eklemelisiniz."
            )

    # --- panel helper'ları ---
    def _find_panel_entry(self, panel):
        for e in self.panels:
            if e["panel"] is panel:
                return e
        return None

    def _panel_exists(self, panel):
        return self._find_panel_entry(panel) is not None

    def close_panel(self, panel):
        entry = self._find_panel_entry(panel)
        if entry:
            self.workspace_canvas.delete(entry["win_id"])
            self.panels.remove(entry)
        if panel is self.compare_panel:
            self.compare_panel = None
        if panel is self.active_panel:
            self.set_active_panel(None)
        panel.destroy()

    # --- drag & resize (canvas dışına taşmayı engelle, manual ⇒ auto_layout off) ---
    def start_move_panel(self, panel, event):
        entry = self._find_panel_entry(panel)
        if entry is None:
            return
        if isinstance(panel, ViewerPanel):
            self.auto_layout = False

        self._drag_state = {
            "mode": "move",
            "entry": entry,
            "start_x_root": event.x_root,
            "start_y_root": event.y_root,
            "orig_x": entry["x"],
            "orig_y": entry["y"],
        }

    def drag_move_panel(self, panel, event):
        if not self._drag_state or self._drag_state.get("mode") != "move":
            return
        if self._drag_state["entry"]["panel"] is not panel:
            return

        dx = event.x_root - self._drag_state["start_x_root"]
        dy = event.y_root - self._drag_state["start_y_root"]

        entry = self._drag_state["entry"]
        new_x = self._drag_state["orig_x"] + dx
        new_y = self._drag_state["orig_y"] + dy

        cw = self.workspace_canvas.winfo_width()
        ch = self.workspace_canvas.winfo_height()
        if cw > 10 and ch > 10:
            max_x = max(0, cw - entry["w"])
            max_y = max(0, ch - entry["h"])
            new_x = min(max(0, new_x), max_x)
            new_y = min(max(0, new_y), max_y)

        entry["x"] = new_x
        entry["y"] = new_y
        self.workspace_canvas.coords(entry["win_id"], new_x, new_y)

    def end_move_panel(self, panel, event):
        if self._drag_state and self._drag_state.get("mode") == "move":
            self._drag_state = None

    def start_resize_panel(self, panel, event):
        entry = self._find_panel_entry(panel)
        if entry is None:
            return
        if isinstance(panel, ViewerPanel):
            self.auto_layout = False

        self._drag_state = {
            "mode": "resize",
            "entry": entry,
            "start_x_root": event.x_root,
            "start_y_root": event.y_root,
            "orig_w": entry["w"],
            "orig_h": entry["h"],
        }

    def drag_resize_panel(self, panel, event):
        if not self._drag_state or self._drag_state.get("mode") != "resize":
            return
        if self._drag_state["entry"]["panel"] is not panel:
            return

        dx = event.x_root - self._drag_state["start_x_root"]
        dy = event.y_root - self._drag_state["start_y_root"]

        entry = self._drag_state["entry"]

        new_w = max(400, self._drag_state["orig_w"] + dx)
        new_h = max(250, self._drag_state["orig_h"] + dy)

        cw = self.workspace_canvas.winfo_width()
        ch = self.workspace_canvas.winfo_height()
        if cw > 10 and ch > 10:
            max_w = max(200, cw - entry["x"])
            max_h = max(150, ch - entry["y"])
            new_w = min(new_w, max_w)
            new_h = min(new_h, max_h)

        entry["w"] = new_w
        entry["h"] = new_h
        self.workspace_canvas.itemconfigure(entry["win_id"], width=new_w, height=new_h)
        entry["panel"].configure(width=new_w, height=new_h)

    def end_resize_panel(self, panel, event):
        if self._drag_state and self._drag_state.get("mode") == "resize":
            self._drag_state = None

    # --- Organize et: Viewer panellerini grid'e yerleştir ---
    def organize_panels(self):
        viewer_entries = [
            e for e in self.panels if isinstance(e["panel"], ViewerPanel)
        ]
        n = len(viewer_entries)
        if n == 0:
            return

        self.workspace_canvas.update_idletasks()
        cw = self.workspace_canvas.winfo_width()
        ch = self.workspace_canvas.winfo_height()
        if cw < 50 or ch < 50:
            return

        if n == 1:
            rows, cols = 1, 1
        elif n == 2:
            rows, cols = 2, 1
        else:
            cols = math.ceil(math.sqrt(n))
            rows = math.ceil(n / cols)

        cell_w = cw / cols
        cell_h = ch / rows
        margin = 4

        for idx, entry in enumerate(viewer_entries):
            r = idx // cols
            c = idx % cols
            x = int(c * cell_w) + margin // 2
            y = int(r * cell_h) + margin // 2
            w = max(200, int(cell_w) - margin)
            h = max(150, int(cell_h) - margin)

            entry["x"] = x
            entry["y"] = y
            entry["w"] = w
            entry["h"] = h

            self.workspace_canvas.coords(entry["win_id"], x, y)
            self.workspace_canvas.itemconfigure(entry["win_id"], width=w, height=h)
            entry["panel"].configure(width=w, height=h)

        self.auto_layout = True


